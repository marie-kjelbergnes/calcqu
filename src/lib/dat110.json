    {
      "question": "What is the population variance?",
      "answer": "\\sigma^2 = \\frac{1}{N}\\sum_{i=1}^{N}(x_i - \\mu)^2"
    },
    {
      "question": "What is the standard deviation?",
      "answer": "s = \\sqrt{s^2}"
    },
    {
      "question": "What is the standard error of the mean?",
      "answer": "SE = \\frac{s}{\\sqrt{n}}"
    },
    {
      "question": "What is the T-test formula?",
      "answer": "t = \\frac{\\overline{x}-\\mu}{s_{\\text{sample }SE}/\\sqrt{n}}"
    },
    {
      "question": "What is the confidence interval (mean, known variance)?",
      "answer": "\\overline{x} \\pm Z \\cdot \\frac{\\sigma}{\\sqrt{n}}"
    },
    {
      "question": "What is the confidence interval (mean, unknown variance)?",
      "answer": "\\overline{x} \\pm t \\cdot \\frac{s}{\\sqrt{n}}"
    },
    {
      "question": "What is the probability density function of a normal distribution?",
      "answer": "f(x) = \\frac{1}{\\sigma\\sqrt{2\\pi}} e^{-\\frac{(x-\\mu)^2}{2\\sigma^2}}"
    },
    {
      "question": "What is the Z-score formula?",
      "answer": "Z = \\frac{x - \\mu}{\\sigma}"
    },
