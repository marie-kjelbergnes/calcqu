      "question": "What is covariance?",
      "answer": "\\text{Cov}(X,Y) = \\frac{1}{n-1}\\sum_{i=1}^{n}(x_i - \\overline{x})(y_i - \\overline{y})"
    },
    {
      "question": "What is the correlation coefficient?",
      "answer": "r = \\frac{\\text{Cov}(X,Y)}{s_X s_Y}"
